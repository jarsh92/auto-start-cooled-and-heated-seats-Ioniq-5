[nemesis]
version=1.1
id=autoseat.heat
name=Auto Seat
type=application,service
package-version=2.0
short-desc="Temperature-based startup heat and ventilation"
os=any
models=any
depends=!coldstart.heat,!auto-seat
preinstall=scripts/check-build.sh
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh

[app.0]
kind=apk
path=app/auto-seat.apk
package=com.nemesis.coldstart
component=com.nemesis.coldstart/.MainActivity

[service.0]
name=apply
kind=sh
path=svc/auto-seat.sh
uid=root
mode=background
